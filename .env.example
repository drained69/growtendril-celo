# GrowTendril configuration. Keep all secrets server-side; never prefix them NEXT_PUBLIC_.

# Required for production
DATABASE_URL=
# Public origin, e.g. https://celo.growtendril.xyz
APP_URL=https://celo.growtendril.xyz
SESSION_SECRET=
ENCRYPTION_KEY=

# Dedicated Celo mainnet signer, bound to ONE workspace. Never expose the key to a browser or LLM.
CELO_AGENT_PRIVATE_KEY=
CELO_AGENT_PROJECT_ID=
# Issued by Loops when you enroll; use that exact code, not a hostname-derived substitute.
CELO_ATTRIBUTION_CODE=
# Set after registering; npm run celo:register previews without sending.
CELO_AGENT_ID=
CELO_MAINNET_RPC=https://forno.celo.org
# Enable only after the same agent wallet has Self Agent ID on Celo mainnet.
SELF_AGENT_ENABLED=0
# Comma-separated HTTPS company-intel endpoints accepting Celo USDC x402 v2.
CELO_RESEARCH_URLS=
# Optional for a server wallet; required for Textile FX conversions from an Altana smart wallet.
TEXTILE_API_KEY=
# Seller setup: obtain X402_API_KEY from https://x402.celo.org
X402_API_KEY=
SIGNALS_PUBLIC_URL=

# Accounts, email and payments
# Email delivery (verification codes, welcome, billing notices, invites) through Resend.
RESEND_API_KEY=
# e.g. GrowTendril <hello@growtendril.xyz> (the domain must be verified in Resend)
EMAIL_FROM=
# Where alerts about USDC that reached the billing address without matching an invoice go (your own inbox).
OPERATOR_EMAIL=
# "Continue with Google". Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prepaid credit: customers top up USDC on Celo to this address (a wallet you control), and each
# service takes its fixed price from their balance (prices live in src/lib/services.ts). Empty = everything free.
BILLING_CELO_ADDRESS=
# Development only: charge for services without a billing address ("Add credit" adds it for free).
# BILLING_DEV=1

# Optional public-source providers and language model.
# AI writing uses Gemini while GEMINI_API_KEY is set, otherwise Claude. LLM_PROVIDER=claude|gemini forces one.
# Free Gemini key: aistudio.google.com/apikey. GEMINI_MODEL takes a comma-separated fallback list.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (sk-ant-usr-…): the workspace ID from the Claude Console.
ANTHROPIC_WORKSPACE_ID=
GITHUB_TOKEN=
# X reads are pay-per-use; leave empty unless the X developer account has credits.
X_BEARER_TOKEN=
# Reddit works without keys (public search feed). Reddit approves new API apps by request.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:growtendril:0.1 (by /u/yourname)
YOUTUBE_API_KEY=
RSS_FEEDS=

# Optional onramp and external scheduler
ONRAMP_API_KEY=
CRON_SECRET=

# Optional standalone paid data service (npm run signals); not registered by default.
SIGNALS_SELLER_ADDRESS=
SIGNALS_API_PORT=4021

# Optional Ed25519 issuer key for signing portable decision receipts (PEM).
CELO_RECEIPT_SIGNING_KEY=
# Historical Arc prototype and Circle passkey integrations remain in source, disabled here.

# Creator escrow on Celo mainnet. Deploy with npm run celo:deploy, then set its printed address.
CELO_REWARDS_ESCROW=
CELO_GROWTH_FACTORY=
CELO_GROWTH_LEDGER=
# Optional: a separate deployer. Without it, the deploy uses CELO_AGENT_PRIVATE_KEY.
CELO_DEPLOYER_PRIVATE_KEY=
