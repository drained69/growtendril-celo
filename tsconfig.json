{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@growth-tools/*": [
        "./packages/growth-tools/dist/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-audit/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-buildcheck/types/**/*.ts",
    ".next-ledger/types/**/*.ts",
    ".next-product-audit/types/**/*.ts",
    ".next-ui/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-smoke/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".data",
    "video",
    "packages/growth-tools/dist"
  ]
}
